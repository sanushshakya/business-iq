  /auth/2fa/:
    get:
      operationId: auth_2fa_retrieve
      description: Whether two-factor sign-in is on for the signed-in user, whether
        they must keep it, and recovery codes left.
      tags:
      - auth
      security:
      - jwtAuth: []
      - cookieAuth: []
      - basicAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TwoFactorStatus'
          description: ''
  /auth/2fa/disable/:
    post:
      operationId: auth_2fa_disable_create
      description: Turn two-factor sign-in off with a current code. Not allowed for
        admins.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TwoFactorCode'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/TwoFactorCode'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/TwoFactorCode'
        required: true
      security:
      - jwtAuth: []
      - cookieAuth: []
      - basicAuth: []
      responses:
        '204':
          description: No response body
  /auth/2fa/enrol/:
    post:
      operationId: auth_2fa_enrol_create
      description: |-
        Start setting up an authenticator app: returns the secret, the ``otpauth://`` URI and a QR code to scan. Send
        the ``challenge`` from ``/auth/login/`` when signing in requires it, or call it signed in. Confirm with
        ``/auth/2fa/enrol/confirm/``.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TwoFactorEnrol'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/TwoFactorEnrol'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/TwoFactorEnrol'
      security:
      - jwtAuth: []
      - cookieAuth: []
      - basicAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TwoFactorEnrolment'
          description: ''
  /auth/2fa/enrol/confirm/:
    post:
      operationId: auth_2fa_enrol_confirm_create
      description: |-
        Finish setting up: a code from the app switches two-factor sign-in on and returns 10 recovery codes (shown
        once). When this was done with a sign-in ``challenge``, the token pair comes back too.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TwoFactorEnrolConfirm'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/TwoFactorEnrolConfirm'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/TwoFactorEnrolConfirm'
        required: true
      security:
      - jwtAuth: []
      - cookieAuth: []
      - basicAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TwoFactorEnrolConfirmed'
          description: ''
  /auth/2fa/users/:
    get:
      operationId: auth_2fa_users_list
      description: |-
        Company staff: the company's password users with their two-factor status, and a reset for someone who lost
        their phone. A reset removes the authenticator and recovery codes, ends their sessions and is recorded
        (``TwoFactorEvent``); they set it up again at their next sign-in (admins must). Operators are not listed.
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      tags:
      - auth
      security:
      - jwtAuth: []
      - cookieAuth: []
      - basicAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedStaffTwoFactorList'
          description: ''
  /auth/2fa/users/{id}/reset/:
    post:
      operationId: auth_2fa_users_reset_create
      description: |-
        Company staff: the company's password users with their two-factor status, and a reset for someone who lost
        their phone. A reset removes the authenticator and recovery codes, ends their sessions and is recorded
        (``TwoFactorEvent``); they set it up again at their next sign-in (admins must). Operators are not listed.
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this User.
        required: true
      tags:
      - auth
      security:
      - jwtAuth: []
      - cookieAuth: []
      - basicAuth: []
      responses:
        '204':
          description: No response body
  /auth/2fa/verify/:
    post:
      operationId: auth_2fa_verify_create
      description: |-
        Second step of signing in: trade the ``challenge`` from ``/auth/login/`` and a 6-digit ``code`` (or one of the
        ``recovery_code``\ s) for the token pair. A wrong code is 400; after 5 the challenge is dead (401, sign in again).
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TwoFactorVerify'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/TwoFactorVerify'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/TwoFactorVerify'
        required: true
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TokenPairResponse'
          description: ''
  /auth/code-login/:
    post:
      operationId: auth_code_login_create
      description: |-
        Sign an operator (till, demand, freight, ...) in with their 8-digit code.

        POST ``{"code": "12345678"}``. Returns the same token pair as ``/auth/login/``. The session can only use what
        their role covers (see ``authentication/role_access.py``). Heavily rate limited, because the code is the whole
        credential.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CodeLogin'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/CodeLogin'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CodeLogin'
        required: true
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TokenPairResponse'
          description: ''
  /auth/invitations/:
    get:
      operationId: auth_invitations_list
      description: |-
        Company staff invite new users by email; the link in the email leads to ``/auth/invitations/accept/``.

        Inviting an address again re-sends the invitation if the previous one expired, and is refused while one is
        still pending or once it has been accepted.
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      tags:
      - auth
      security:
      - jwtAuth: []
      - cookieAuth: []
      - basicAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedInvitationList'
          description: ''
    post:
      operationId: auth_invitations_create
      description: |-
        Company staff invite new users by email; the link in the email leads to ``/auth/invitations/accept/``.

        Inviting an address again re-sends the invitation if the previous one expired, and is refused while one is
        still pending or once it has been accepted.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/InvitationCreate'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/InvitationCreate'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/InvitationCreate'
        required: true
      security:
      - jwtAuth: []
      - cookieAuth: []
      - basicAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Invitation'
          description: ''
  /auth/invitations/{id}/:
    get:
      operationId: auth_invitations_retrieve
      description: |-
        Company staff invite new users by email; the link in the email leads to ``/auth/invitations/accept/``.

        Inviting an address again re-sends the invitation if the previous one expired, and is refused while one is
        still pending or once it has been accepted.
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this user invitation.
        required: true
      tags:
      - auth
      security:
      - jwtAuth: []
      - cookieAuth: []
      - basicAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Invitation'
          description: ''
    delete:
      operationId: auth_invitations_destroy
      description: |-
        Company staff invite new users by email; the link in the email leads to ``/auth/invitations/accept/``.

        Inviting an address again re-sends the invitation if the previous one expired, and is refused while one is
        still pending or once it has been accepted.
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this user invitation.
        required: true
      tags:
      - auth
      security:
      - jwtAuth: []
      - cookieAuth: []
      - basicAuth: []
      responses:
        '204':
          description: No response body
  /auth/invitations/accept/:
    post:
      operationId: auth_invitations_accept_create
      description: |-
        Handle POST requests to accept an invitation.

        :param request: The incoming HTTP request
        :return: A JSON response indicating success or failure
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AcceptInvitationRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AcceptInvitationRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AcceptInvitationRequest'
        required: true
      security:
      - jwtAuth: []
      - cookieAuth: []
      - basicAuth: []
      - {}
      responses:
        '201':
          description: No response body
  /auth/login/:
    post:
      operationId: auth_login_create
      description: |-
        Exchange credentials for an access token and a refresh token.

        POST ``{"username": <email>, "password": ...}``. Send ``access_token`` as
        ``Authorization: Bearer <access_token>``; when it expires, trade ``refresh_token`` for a new
        pair at ``/auth/token/refresh/``.

        With two-factor sign-in on (always, for admins) the answer is ``{"two_factor": "verify" | "enrol",
        "challenge", "expires_in"}`` instead of tokens: finish at ``/auth/2fa/verify/`` or ``/auth/2fa/enrol/``.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/LoginUser'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/LoginUser'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/LoginUser'
        required: true
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LoginResponse'
          description: ''
  /auth/logout/:
    post:
      operationId: auth_logout_create
      description: Revoke the session a refresh token belongs to. Always returns 204,
        even for unknown tokens.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/RefreshToken'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/RefreshToken'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/RefreshToken'
        required: true
      security:
      - {}
      responses:
        '204':
          description: No response body
  /auth/me/:
    get:
      operationId: auth_me_retrieve
      description: 'Who is signed in: used by the app to decide what to show.'
      tags:
      - auth
      security:
      - jwtAuth: []
      - cookieAuth: []
      - basicAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Me'
          description: ''
  /auth/password_reset/:
    post:
      operationId: auth_password_reset_create
      description: |-
        Start a password reset: email the account a link carrying the ``uidb64`` and ``token`` that
        ``/auth/password_reset/confirm/`` expects.

        The answer is the same whether or not the address has an account, so this cannot be used to find out
        who is registered. It is rate limited (``PASSWORD_RESET_THROTTLE_RATE``).
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PasswordResetRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PasswordResetRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PasswordResetRequest'
        required: true
      security:
      - {}
      responses:
        '200':
          description: No response body
  /auth/password_reset/confirm/:
    post:
      operationId: auth_password_reset_confirm_create
      description: |-
        Confirm a password reset.

        Expects a POST with 'uidb64', 'token', 'new_password1' and 'new_password2'. The token is
        checked against the user identified by 'uidb64'; on success the password is replaced.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PasswordResetConfirm'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PasswordResetConfirm'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PasswordResetConfirm'
        required: true
      security:
      - jwtAuth: []
      - cookieAuth: []
      - basicAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /auth/token/refresh/:
    post:
      operationId: auth_token_refresh_create
      description: |-
        Trade a refresh token for a new access + refresh token.

        Refresh tokens are single use: the one you send is revoked and replaced. Sending a token that
        was already used revokes the whole session, so always store the newest ``refresh_token``.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/RefreshToken'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/RefreshToken'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/RefreshToken'
        required: true
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TokenPairResponse'
          description: ''
