components:
  schemas:
    AcceptInvitationRequest:
      type: object
      properties:
        token:
          type: string
          format: uuid
        password:
          type: string
      required:
      - password
      - token
    AlternativeSupplier:
      type: object
      description: |-
        ModelSerializer that stops one company referencing another's data.

        * related-object fields only accept rows the user's company owns
        * ``company`` is read-only for users that belong to a company (it is set from the user)
        * unique constraints that include ``company`` are checked against the user's company, so a duplicate
          is a clean 400 (DRF skips them because ``company`` is read-only) and one company can never learn
          that another uses a name or number
      properties:
        id:
          type: integer
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
        name:
          type: string
          maxLength: 255
        country_of_origin:
          type: string
          maxLength: 100
        product_categories:
          description: Names of the product categories supplied, e.g. ['Dried fruit'].
        lead_time_days:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
          description: Typical days from order to delivery.
        company:
          type: integer
      required:
      - company
      - country_of_origin
      - created_at
      - id
      - lead_time_days
      - name
      - updated_at
    BarcodeRule:
      type: object
      description: A scale-label layout. ``value_length`` is what is left of the 13
        digits for the price or weight.
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 100
        prefix:
          type: string
          description: 1 to 3 digits starting with 2, e.g. 20.
          maxLength: 3
        item_code_length:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
        value_type:
          $ref: '#/components/schemas/ValueTypeEnum'
        decimals:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
        value_check_digit:
          type: boolean
          description: A GS1 check digit sits before the value.
        value_length:
          type: integer
          readOnly: true
        is_active:
          type: boolean
      required:
      - id
      - item_code_length
      - prefix
      - value_length
      - value_type
    BlankEnum:
      enum:
      - ''
    Branch:
      type: object
      description: |-
        ModelSerializer that stops one company referencing another's data.

        * related-object fields only accept rows the user's company owns
        * ``company`` is read-only for users that belong to a company (it is set from the user)
        * unique constraints that include ``company`` are checked against the user's company, so a duplicate
          is a clean 400 (DRF skips them because ``company`` is read-only) and one company can never learn
          that another uses a name or number
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          title: Branch Name
          maxLength: 255
        address:
          type: string
        is_active:
          type: boolean
        created_at:
          type: string
          format: date-time
          readOnly: true
        company:
          type: integer
      required:
      - address
      - company
      - created_at
      - id
      - name
    BranchDemandAlert:
      type: object
      description: |-
        ModelSerializer that stops one company referencing another's data.

        * related-object fields only accept rows the user's company owns
        * ``company`` is read-only for users that belong to a company (it is set from the user)
        * unique constraints that include ``company`` are checked against the user's company, so a duplicate
          is a clean 400 (DRF skips them because ``company`` is read-only) and one company can never learn
          that another uses a name or number
      properties:
