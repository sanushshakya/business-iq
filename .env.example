# .env.example -- copy to .env and fill in. Never commit .env.

# Django
# Must be 32+ characters and unique per environment. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost

# Database. Defaults to SQLite (DB_NAME is then a file path). For Postgres set
# DB_ENGINE=django.db.backends.postgresql and the DB_* values below.
# docker compose always uses its own Postgres container and only needs DB_NAME/DB_USER/DB_PASSWORD.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=iq_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Redis / Celery / Channels
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
USE_REDIS_CHANNELS=False

# API login: token lifetimes (seconds) and rate limits
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_REFRESH_TOKEN_TTL_SECONDS=1209600
JWT_REFRESH_SESSION_MAX_AGE_SECONDS=7776000
JWT_REFRESH_REUSE_LEEWAY_SECONDS=10
LOGIN_THROTTLE_RATE=10/min
REFRESH_THROTTLE_RATE=30/min

# Comma-separated Fernet keys for encrypted fields (defaults to a key derived from SECRET_KEY)
FIELD_ENCRYPTION_KEYS=

# External services (all optional; the Hijri calendar and UK Trade Tariff APIs are public and need no key)
HTTP_TIMEOUT_SECONDS=10
ALADHAN_API_URL=https://api.aladhan.com/v1
HMRC_API_URL=https://www.trade-tariff.service.gov.uk/api/v2
SHOPIFY_API_VERSION=2026-10
DEFAULT_CUSTOMS_DUTY_RATE=0.0
FREIGHT_RATES_API_URL=
RATE_CHANGE_THRESHOLD=5.0
USE_REDIS_CACHE=False
